# Projet Supabase SHENA existant. Aucune valeur réelle dans ce fichier.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# live par défaut : aucun remplacement par des exemples en cas d'erreur.
# demo est réservé à la revue et aux tests, avec bandeaux explicites.
SHENA_CATALOG_MODE=live

# Origine de confiance pour récupération de mot de passe (serveur uniquement).
SHENA_SITE_URL=https://shena-2go5.vercel.app

# Staging : projet confirmé, aucune clé réelle dans Git.
# Le préfixe SHENA_STAGING est utilisé uniquement par le script de contrôle ;
# l'application Preview doit recevoir ses valeurs dans NEXT_PUBLIC_SUPABASE_*.
SHENA_STAGING_SUPABASE_URL=https://prqmomjtmyhqijysfoog.supabase.co
SHENA_STAGING_SUPABASE_PUBLISHABLE_KEY=
SHENA_STAGING_PROJECT_REF=prqmomjtmyhqijysfoog
# Preview : SHENA_DEPLOYMENT_TARGET=staging obligatoire, URL staging exacte.
SHENA_DEPLOYMENT_TARGET=
# Ne passer à staging qu'après validation des tables/RLS ; Production toujours bloquée.
SHENA_CHECKOUT_MODE=disabled
# Identifiants de tests réels facultatifs : à configurer uniquement dans le coffre local.
SHENA_STAGING_ADMIN_A_EMAIL=
SHENA_STAGING_ADMIN_A_PASSWORD=
SHENA_STAGING_ADMIN_B_EMAIL=
SHENA_STAGING_ADMIN_B_PASSWORD=
SHENA_STAGING_CLIENT_EMAIL=
SHENA_STAGING_CLIENT_PASSWORD=
